# Copy to compose.env and fill in. Referenced by docker/compose.yml
# (compose.env is read for interpolation automatically by `docker compose`
# when named `.env`; rename or pass --env-file=docker/compose.env if kept
# as compose.env instead).

# Host path to your media library, bind-mounted read-only at /media.
MEDIA_PATH=/path/to/media

# Optional: only needed with `docker compose --profile postgres up`.
POSTGRES_USER=impostarr
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=impostarr
